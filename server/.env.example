# ==============================================================================
# GOVIND DOSA ENTERPRISE SERVER • ENVIRONMENT VARIABLES
# ==============================================================================

# Server Listening Port (Assigned automatically by Render or default 5000)
PORT=5000

# Environment Mode
NODE_ENV=production

# PostgreSQL Database Connection String (Neon.tech or Supabase)
# If omitted, server will gracefully run in high-speed In-Memory (store.js) mode.
DATABASE_URL=postgresql://neondb_owner:password@ep-cool-butterfly-1234.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Frontend URL for CORS and WebSocket authorization
CLIENT_URL=https://govind-dosa-enterprise.vercel.app
